{
	"version": "0.1.0",
	"description": "A comprehensive full-stack application template",
	"license": "MIT",
	"nodeModulesDir": "auto",
	"minimumDependencyAge": "0",
	"workspace": ["./sdk/**", "./apps/**"],
	"exclude": [
