		"vite-plus": "npm:vite-plus",
		"tailwindcss": "npm:tailwindcss",
		"@tailwindcss/vite": "npm:@tailwindcss/vite",
		"daisyui": "npm:daisyui",
		"esm-env": "npm:esm-env",
		"arktype": "npm:arktype",
		"paper": "npm:paper@0.12.18",
		"xstate": "npm:xstate@^5.19.0",
		"valibot": "npm:valibot@^1.0.0",
		"polygon-clipping": "npm:polygon-clipping@0.15.7",
		"rbush": "npm:rbush@^4.0.0",
		"jspdf": "npm:jspdf@^3.0.0",
		"svg2pdf.js": "npm:svg2pdf.js@^2.2.0",
		"pdf-lib": "npm:pdf-lib@1.17.1",
		"pptxgenjs": "npm:pptxgenjs@^4.0.0",
		"fflate": "npm:fflate@0.8.2",
